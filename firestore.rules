rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admins are identified by their verified sign-in email.
    // Keep this list in sync with ADMIN_EMAILS in src/lib/config.ts.
    function adminEmails() {
      return ['zzeidnaser@gmail.com', 'zz@gmail.com'];
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email in adminEmails();
    }

    // User profiles
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // A user may create their own profile; only admins (by email) may hold
      // the 'admin' role — a normal user cannot self-promote.
      allow create: if isOwner(uid)
        && (request.resource.data.role == 'user' || isAdmin());
      allow update: if isAdmin()
        || (isOwner(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Applications — one document per user, id == uid
    match /applications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
